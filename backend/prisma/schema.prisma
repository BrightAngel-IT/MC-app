generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  OVERSEAS_GUARDIAN
  DOCTOR
  NURSE
  CAREGIVER
  LAB_TECH
  PARAMEDIC
  PHARMACIST
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  fullName           String
  phone              String?
  role               Role
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  expoPushToken      String?

  patientProfile      PatientProfile?
  professionalProfile ProfessionalProfile?
  pharmacistProfile   PharmacistProfile?
  adminProfile        AdminProfile?

  activityLogs  ActivityLog[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  relatedId String? // Optional ID for linking (e.g. appointmentId)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PatientProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  fullName         String
  dob              DateTime?
  address          String?
  emergencyContact String?
  nicNumber        String?

  user User @relation(fields: [userId], references: [id])

  appointments  Appointment[]
  prescriptions Prescription[]
  orders        Order[]
  emergencySOSs EmergencySOS[]
}

model ProfessionalProfile {
  id                     String  @id @default(uuid())
  userId                 String  @unique
  fullName               String
  specialization         String?
  qualifications         String?
  licenseFrontImage      String? @db.Text
  licenseBackImage       String? @db.Text
  address                String?
  idCardNumber           String?
  workingHospital        String?
  isCurrentlyWorking     Boolean @default(true)
  ambulanceVehicleNumber String?
  attachedHospital       String?
  availabilityStatus     String  @default("AVAILABLE")
  rating                 Float   @default(0.0)
  licenseIssuedYear      Int?
  licenseNumber          String?
  idFrontImage           String? @db.Text
  idBackImage            String? @db.Text

  user User @relation(fields: [userId], references: [id])

  appointments  Appointment[]
  prescriptions Prescription[]
  emergencySOSs EmergencySOS[]
}

model PharmacistProfile {
  id                String  @id @default(uuid())
  userId            String  @unique
  businessName      String
  licenseNumber     String?
  licenseIssuedYear Int?
  licenseFrontImage String? @db.Text
  licenseBackImage  String? @db.Text
  idFrontImage      String? @db.Text
  idBackImage       String? @db.Text
  address           String?
  idCardNumber      String?

  user User @relation(fields: [userId], references: [id])

  products Product[]
  orders   Order[]
}

model AdminProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  fullName     String
  adminLevel   String  @default("MANAGER")
  idFrontImage String? @db.Text
  idBackImage  String? @db.Text
  idCardNumber String?

  user User @relation(fields: [userId], references: [id])
}

model Appointment {
  id             String    @id @default(uuid())
  patientId      String
  professionalId String
  serviceType    String
  scheduledDate  DateTime
  status         String    @default("PENDING")
  locationLat    Float?
  locationLng    Float?
  symptoms       String?   @db.Text
  vitalsSummary  String?   @db.Text
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  patient       PatientProfile       @relation(fields: [patientId], references: [id])
  professional  ProfessionalProfile  @relation(fields: [professionalId], references: [id])
  prescriptions Prescription[]
  messages      AppointmentMessage[]
}

model AppointmentMessage {
  id            String   @id @default(uuid())
  appointmentId String
  sender        String // 'PATIENT' or 'PROFESSIONAL'
  text          String   @db.Text
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

model Prescription {
  id             String   @id @default(uuid())
  appointmentId  String
  professionalId String
  patientId      String
  notes          String?  @db.Text
  status         String   @default("ACTIVE")
  issuedAt       DateTime @default(now())

  appointment  Appointment         @relation(fields: [appointmentId], references: [id])
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  patient      PatientProfile      @relation(fields: [patientId], references: [id])
  items        PrescriptionItem[]

  orders Order[]
}

model PrescriptionItem {
  id             String @id @default(uuid())
  prescriptionId String
  medicineName   String
  dosage         String
  duration       String

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
}

model Product {
  id                     String  @id @default(uuid())
  pharmacistId           String
  name                   String
  description            String? @db.Text
  price                  Float
  stock                  Int     @default(0)
  category               String
  isPrescriptionRequired Boolean @default(false)
  imageUrl1              String? @db.Text
  imageUrl2              String? @db.Text
  stockUnit              String  @default("Pieces")

  pharmacist PharmacistProfile @relation(fields: [pharmacistId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id             String    @id @default(uuid())
  patientId      String
  pharmacistId   String
  prescriptionId String?
  totalAmount    Float     @default(0.0)
  status         String    @default("PROCESSING")
  vendorNotes    String?   @db.Text
  patientNotes   String?   @db.Text
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  patient      PatientProfile    @relation(fields: [patientId], references: [id])
  pharmacist   PharmacistProfile @relation(fields: [pharmacistId], references: [id])
  prescription Prescription?     @relation(fields: [prescriptionId], references: [id])
  items        OrderItem[]
  messages     OrderMessage[]
}

model OrderMessage {
  id        String   @id @default(uuid())
  orderId   String
  sender    String // 'PATIENT' or 'VENDOR'
  text      String   @db.Text
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtPurchase Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model EmergencySOS {
  id          String   @id @default(uuid())
  patientId   String
  paramedicId String?
  locationLat Float
  locationLng Float
  status      String   @default("TRIGGERED")
  triggeredAt DateTime @default(now())

  patient   PatientProfile       @relation(fields: [patientId], references: [id])
  paramedic ProfessionalProfile? @relation(fields: [paramedicId], references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  actionType  String
  description String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model RejectedRecord {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  idCardNumber String?  @unique
  rejectedAt   DateTime @default(now())
}
